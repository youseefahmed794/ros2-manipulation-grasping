<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="parallel_gripper" params="parent *origin">

    <link name="gripper_base">
      <visual>
        <geometry>
          <box size="0.08 0.05 0.04"/>
        </geometry>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <material name="dark_gray">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.08 0.05 0.04"/>
        </geometry>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>

    <joint name="gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="gripper_base"/>
    </joint>

    <!-- Left Finger (Prismatic) -->
    <link name="gripper_left_finger">
      <visual>
        <geometry>
          <box size="0.015 0.02 0.08"/>
        </geometry>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <material name="finger_material">
          <color rgba="0.85 0.3 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.015 0.02 0.08"/>
        </geometry>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="gripper_left_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="gripper_left_finger"/>
      <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.0425" effort="60.0" velocity="0.1"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <!-- Right Finger (Prismatic) -->
    <link name="gripper_right_finger">
      <visual>
        <geometry>
          <box size="0.015 0.02 0.08"/>
        </geometry>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <material name="finger_material"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.015 0.02 0.08"/>
        </geometry>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="gripper_right_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="gripper_right_finger"/>
      <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.0425" effort="60.0" velocity="0.1"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <!-- Tool Center Point (TCP): Center of fingers at tips -->
    <link name="tcp"/>
    <joint name="tcp_joint" type="fixed">
      <parent link="gripper_base"/>
      <child link="tcp"/>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
