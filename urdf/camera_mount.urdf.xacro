<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="overhead_camera" params="parent *origin">

    <link name="camera_stand">
      <visual>
        <geometry>
          <cylinder radius="0.02" length="0.8"/>
        </geometry>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.8"/>
        </geometry>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="camera_stand_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="camera_stand"/>
    </joint>

    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.04 0.12 0.03"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="camera_silver">
          <color rgba="0.7 0.7 0.75 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.12 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Tilted 70 degrees down facing manipulation table -->
    <joint name="camera_joint" type="fixed">
      <parent link="camera_stand"/>
      <child link="camera_link"/>
      <origin xyz="0.15 0 0.78" rpy="0 1.22 0"/>
    </joint>

    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Gazebo RGB-D Camera Sensor Plugin -->
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/points</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
