<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="tabletop_manipulation">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Industrial Worktable -->
    <model name="worktable">
      <static>true</static>
      <pose>0.5 0.0 0.375 0 0 0</pose>
      <link name="link">
        <visual name="top_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box><size>0.8 1.2 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.45 0.3 1</ambient>
            <diffuse>0.7 0.5 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box><size>0.8 1.2 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- Table Legs -->
        <visual name="leg1"><pose>0.35 0.55 0 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg2"><pose>-0.35 0.55 0 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg3"><pose>0.35 -0.55 0 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg4"><pose>-0.35 -0.55 0 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Pick Object 1: Red Cube -->
    <model name="red_cube">
      <pose>0.45 0.0 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.00003</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00003</iyy><iyz>0</iyz>
            <izz>0.00003</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.04 0.04 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Pick Object 2: Green Cylinder -->
    <model name="green_cylinder">
      <pose>0.55 0.15 0.78 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.07</mass>
          <inertia>
            <ixx>0.000025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000025</iyy><iyz>0</iyz>
            <izz>0.000015</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.06</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.1 0.85 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.02</radius><length>0.06</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Place Target: Sorting Bin -->
    <model name="sorting_bin">
      <static>true</static>
      <pose>0.25 0.45 0.76 0 0 0</pose>
      <link name="link">
        <visual name="bottom">
          <geometry><box><size>0.18 0.18 0.02</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient></material>
        </visual>
        <collision name="bottom_col">
          <geometry><box><size>0.18 0.18 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
